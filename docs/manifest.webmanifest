{
  "name": "4WON'S PLANNER",
  "short_name": "4WON'S PLANNER",
  "description": "마감일과 리마인드 시작 시점을 정하면 완료할 때까지 매주 체크리스트에 다시 올라오는 투두·캘린더 플래너",
  "lang": "ko",
  "start_url": "./#week",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f2f4f6",
  "theme_color": "#1d5c8c",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "이번 주",
      "url": "./#week"
    },
    {
      "name": "캘린더",
      "url": "./#calendar"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+planner",
      "url": "./?open=%s"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  }
}
